{
  "markdownlint.config": {
    "MD033": {
      "allowed_elements": [
        "sup",
        "sub",
        "img"
      ]
    }
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    ".mule": true
  },
  "code-runner.clearPreviousOutput": true,
  "code-runner.saveAllFilesBeforeRun": true,
  "python.languageServer": "Pylance"
}